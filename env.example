# Copy this file to `.env` and fill in the values:  cp env.example .env
#
# ---- LLM (local Ollama) ----
# Powers the enrich / score / draft stages. Requires `ollama serve` running
# locally with the model pulled (`ollama pull llama3`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Sampling temperature for generation.
LLM_TEMPERATURE=0.2

# ---- Pipeline storage / output ----
AIJOBHUNTER_DB_PATH=./data/aijobhunter.db
AIJOBHUNTER_OUTPUT_DIR=./output

# ---- Config file locations ----
AIJOBHUNTER_PORTALS_CONFIG=./config/portals.yaml
AIJOBHUNTER_PROFILE_CONFIG=./config/profile.yaml

# ---- Relevance ----
# Minimum fit score (0-100) for a job to be drafted/exported.
AIJOBHUNTER_SCORE_THRESHOLD=70

# ---- LinkedIn browser profile (persistent login) ----
# Directory where Playwright stores the logged-in Chrome profile so you only
# log in / solve 2FA once.
AIJOBHUNTER_BROWSER_PROFILE_DIR=./data/browser-profile
